<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="FOKUS" android:textColor="#A1AAAF" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:maxLines="1"/>
    <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F5C542" android:textSize="13sp" android:textStyle="bold" android:text="Racha 0 sem"/>
    <ImageView android:id="@+id/w_mic" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginLeft="10dp"
        android:padding="7dp" android:background="@drawable/mic_bg" android:src="@drawable/ic_mic" android:contentDescription="Orden por voz"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
    <TextView android:id="@+id/d0" style="@style/Dot" android:text="L"/>
    <TextView android:id="@+id/d1" style="@style/Dot" android:text="M"/>
    <TextView android:id="@+id/d2" style="@style/Dot" android:text="X"/>
    <TextView android:id="@+id/d3" style="@style/Dot" android:text="J"/>
    <TextView android:id="@+id/d4" style="@style/Dot" android:text="V"/>
    <TextView android:id="@+id/d5" style="@style/Dot" android:text="S"/>
    <TextView android:id="@+id/d6" style="@style/Dot" android:text="D"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_rest" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
      android:gravity="center_vertical" android:layout_marginTop="10dp" android:background="@drawable/rest_bg" android:paddingLeft="14dp" android:paddingRight="14dp"
      android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DESCANSO" android:textColor="#F5C542" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"/>
      <TextView android:id="@+id/w_rest_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F2F5F6" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10dp"
        android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" android:fontFeatureSettings="tnum"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/w_week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F2F5F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"/>
      <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A1AAAF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
      <TextView android:id="@+id/w_cycle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:background="@drawable/btn_bg" android:text="Empezar"
        android:textColor="#06100B" android:textSize="14sp" android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
