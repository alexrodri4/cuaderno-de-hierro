<resources>
  <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/fk_bg</item>
    <item name="android:statusBarColor">#080C0E</item>
    <item name="android:navigationBarColor">#0B1012</item>
  </style>
  <style name="Dot">
    <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item>
    <item name="android:layout_height">30dp</item><item name="android:layout_marginLeft">3dp</item><item name="android:layout_marginRight">3dp</item>
    <item name="android:gravity">center</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item>
    <item name="android:textColor">#A1AAAF</item><item name="android:background">@drawable/dot_off</item>
  </style>
</resources>
